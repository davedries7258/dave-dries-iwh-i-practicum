doctype html
html
    head
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Update Houseplants
        a(href="/") Return to the homepage
        .form-wrapper
            form(action="/update-cobj" method="POST")
                label(for="name") Name:
                input(type="text" name="name" id="name" required)
                label(for="species") Species:
                input(type="text" name="species" id="species" required)
                label(for="watering_schedule") Watering Schedule:
                input(type="text" name="watering_schedule" id="watering_schedule" required)
                input(type="submit" value="Submit")
